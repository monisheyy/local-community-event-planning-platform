# ---------------------------------------------------------------
# Local development needs NO settings: SQLite + local uploads are used.
# Copy to .env and fill in the Azure values to use Azure services.
# On Azure App Service, set these as "Application settings" instead.
# ---------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Required in production. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (only needed if the frontend is hosted separately)
CORS_ORIGIN=http://localhost:5173

# ---- Azure SQL Database (option A: one connection string) ----
# AZURE_SQL_CONNECTION_STRING=Server=tcp:<server>.database.windows.net,1433;Database=<db>;User Id=<user>;Password=<password>;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;

# ---- Azure SQL Database (option B: separate values) ----
# AZURE_SQL_SERVER=<server>.database.windows.net
# AZURE_SQL_DATABASE=communityevents
# AZURE_SQL_USER=
# AZURE_SQL_PASSWORD=

# ---- Azure Blob Storage (event images) ----
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=event-images

# ---- Azure Monitor / Application Insights (optional) ----
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# ---- Local fallbacks (optional) ----
# SQLITE_FILE=./data/community-events.db
# UPLOAD_DIR=./uploads
