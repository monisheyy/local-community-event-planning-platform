{
  "name": "community-events-api",
  "version": "1.0.0",
  "description": "REST API for the Local Community Event Planning Platform (Node.js + Express, Azure SQL / Azure Blob Storage)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.4",
    "multer": "^2.4.0",
    "sql.js": "^1.14.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "optionalDependencies": {
    "applicationinsights": "^3.17.0"
  }
}
